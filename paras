#!/usr/bin/env bash
# paras: put any software into your language, and prove it still works.
# Paras on SHAKTI is Parashakti: the whole sovereign stack, from the chip to AI, IoT and robotics.
# Everything runs inside a container, so nothing is installed on your machine and nothing needs sudo.
# © 1993–2026 Abhishek Choudhary. All rights reserved. AyeAI. Paras™, Parashakti™ and Hindawi™ are his trademarks.
set -uo pipefail
VERSION=2026.10.0
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
WORK="${PARAS_WORK:-$PWD/paras-work}"; IMAGE="paras-env:$VERSION"; ORG=hmnsq

help() { cat <<'HELP'
paras: put any software into your language, and prove it still works.

  paras --ingest <repository>          ingest it into every ready language, check it, build it, run it, report
  paras --report <repository>          ingest and check only, and report what is still to be translated
  paras --stack                        the whole sovereign stack, layer by layer: each upstream forked into hmnsq,
                                       each language on its own branch, published on GitHub

  <repository> is any Git URL (GitHub, GitLab, Bitbucket, your own server) or a folder on this machine.

Also:
  --langs urdu,tamil        only these languages (paras --languages lists them all)
  --publish [ORG]           publish each language as a branch of a fork in ORG (default hmnsq)
  --build CMD  --run CMD  --expect TEXT
                            how to build and run it, and what it must print, if paras cannot find out itself
  --list                    the stack, layer by layer        --languages   the languages
  --status | --stop         where a run is, or stop it (a rerun carries on from where it stopped)
  --shell                   a shell inside the container
  --local                   run here, without a container (where Docker is not available, as on Colab)
  --version | --help

Your work stays in ./paras-work. Your intention is asked for once per run, never per step.
HELP
}
say() { printf '\033[1m%s\033[0m\n' "$*"; }
[ $# -eq 0 ] && { help; exit 0; }
LOCAL=0; MODE=""; TARGET=""; PUB=""; PASS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) help; exit 0 ;;
    --version) echo "paras $VERSION"; exit 0 ;;
    --ingest|--report) MODE="${1#--}"; TARGET="${2:-}"; [ -n "$TARGET" ] || { echo "paras: $1 needs a repository"; exit 2; }; shift ;;
    --stack) MODE=stack ;;
    --publish) PUB="$ORG"; [ -n "${2:-}" ] && [ "${2#-}" = "$2" ] && { PUB="$2"; shift; } ;;
    --local) LOCAL=1 ;;
    --shell) MODE=shell ;;
    --list|--languages|--status|--stop) PASS+=("$1"); MODE="${MODE:-info}" ;;
    --langs|--build|--run|--expect) PASS+=("$1" "${2:-}"); shift ;;
    *) echo "paras: I do not know $1 (paras --help)"; exit 2 ;;
  esac; shift
done
[ -d "$TARGET" ] && TARGET="$(cd "$TARGET" && pwd)"
ARGS=(--no-ui)
case "$MODE" in
  ingest) ARGS+=(--url "$TARGET") ;;
  report) ARGS+=(--url "$TARGET" --steps ingest,check,report) ;;
  stack)  ARGS+=(--fork-all "${PUB:-$ORG}" --publish "${PUB:-$ORG}") ;;
esac
[ -n "$PUB" ] && [ "$MODE" != stack ] && ARGS+=(--publish "$PUB")
ARGS+=("${PASS[@]}")

# ---- the author's intention, once for the whole run, when something will be published
CONSENT=""
if [ "$MODE" = stack ] || [ -n "$PUB" ]; then
  say "This run will publish to github.com/${PUB:-$ORG}:"
  [ "$MODE" = stack ] && echo "   every upstream of the stack forked (or mirrored), then each verified language pushed as a branch" \
                      || echo "   $TARGET forked (or mirrored), then each verified language pushed as a branch"
  printf '   Type YES and a reason, once; nothing else will ask.\n   > '; read -r line || true
  [ "$(echo "$line" | awk '{print toupper($1)}' | tr -dc 'A-Z')" = YES ] || { say "nothing done"; exit 0; }
  CONSENT="PUSH ${line#* }"
fi
mkdir -p "$WORK"
if [ "$LOCAL" = 1 ]; then
  say "running here, without a container"
  cd "$WORK" && PARAS_VERBOSE=1 PARAS_CONSENT="$CONSENT" exec bash "$HERE/engine/paras-engine.sh" "${ARGS[@]}"
fi

# ---- the container: built once (shown as it builds), then reused
command -v docker >/dev/null || { echo "paras: Docker is not installed. Install Docker, or run with --local."; exit 1; }
docker info >/dev/null 2>&1 || { echo "paras: Docker is installed but not reachable by this user (is the daemon running? are you in the docker group?)"; exit 1; }
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  say "Building the paras container once (every tool it needs; a few minutes, shown as it goes)"
  docker build -t "$IMAGE" -f "$HERE/Dockerfile" "$HERE" || { echo "paras: the container did not build (see above)"; exit 1; }
fi
TOKEN="${GH_TOKEN:-$(gh auth token 2>/dev/null)}"
[ -n "$TOKEN" ] && say "GitHub: your login is handed to the container" || echo "GitHub: not logged in here (gh auth login); publishing will not work"
ZEN="${ZENODO_TOKEN:-}"; [ -z "$ZEN" ] && [ -f "$HOME/Documents/zenodo_token_20260612" ] && ZEN="$(cat "$HOME/Documents/zenodo_token_20260612")"
GPU=(); docker info 2>/dev/null | grep -qi nvidia && GPU=(--gpus all) && say "GPU: passed to the container"
TTY=(-i); [ -t 0 ] && TTY=(-it)
CMD=(bash /opt/paras/engine/paras-engine.sh "${ARGS[@]}"); [ "$MODE" = shell ] && CMD=(bash)
say "paras $VERSION · work in $WORK"
exec docker run --rm "${TTY[@]}" "${GPU[@]}" -e GH_TOKEN="$TOKEN" -e ZENODO_TOKEN="$ZEN" -e PARAS_VERBOSE=1 -e PARAS_CONSENT="$CONSENT" \
  -v "$HERE":/opt/paras:ro -v "$WORK":/work -w /work "$IMAGE" "${CMD[@]}"
